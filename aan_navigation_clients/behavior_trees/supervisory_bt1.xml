<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Parallel success_threshold="1" failure_threshold="1">
      
      <!-- Robot 1 Sequential Tasks -->
      <Sequence name="Robot1TaskSequence">
        
        <!-- Step 1: Navigate to Pose -->
        <ReactiveSequence name="NavigateToPoseSequence">
          <AbstractConditionMet robot="diffbot_1"/>
          <SubTree ID="NavigateToPose" robot="diffbot_1"/>
        </ReactiveSequence>
        
        <!-- Step 2: Navigate Exact Path -->
        <ReactiveSequence name="NavigateExactPathSequence">
          <AbstractConditionMet robot="diffbot_1"/>
          <SubTree ID="NavigateExactPath" robot="diffbot_1"/>
        </ReactiveSequence>
        
        <!-- Step 3: Row Follow -->
        <ReactiveSequence name="RowFollowSequence">
          <AbstractConditionMet robot="diffbot_1"/>
          <SubTree ID="NavigateRowFollowing" robot="diffbot_1"/>
        </ReactiveSequence>
        
        <!-- Step 4: Dock -->
        <ReactiveSequence name="DockSequence">
          <AbstractConditionMet robot="diffbot_1"/>
          <SubTree ID="NavigateDocking" robot="diffbot_1"/>
        </ReactiveSequence>
        
        <!-- Recovery Mechanism -->
        <RecoveryNode number_of_retries="3" name="Robot1Recovery">
          <Fallback name="Robot1RecoveryFallback">
            <GoalUpdated/>
            <Spin spin_dist="1.57"/>
            <BackUp backup_dist="0.30" backup_speed="0.05"/>
          </Fallback>
        </RecoveryNode>
      </Sequence>
            
    </Parallel>
  </BehaviorTree>
  
  <!-- Subtrees for different tasks -->
  <BehaviorTree ID="NavigateToPose">
    <Include filename="navigate_to_pose.xml"/>
  </BehaviorTree>
  
  <BehaviorTree ID="NavigateExactPath">
    <Include filename="navigate_exact_path.xml"/>
  </BehaviorTree>
  
  <BehaviorTree ID="NavigateRowFollowing">
    <Include filename="navigate_row_following.xml"/>
  </BehaviorTree>
  
  <BehaviorTree ID="NavigateDocking">
    <Include filename="navigate_docking.xml"/>
  </BehaviorTree>
</root>
